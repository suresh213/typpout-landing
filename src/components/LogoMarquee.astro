---
const logos = [
  { name: "Nemetschek Group", logoKey: "nemetschek", ext: "png", heightClass: "h-6 sm:h-7" },
  { name: "CARPL", logoKey: "carpl", ext: "png", heightClass: "h-7 sm:h-8" },
  { name: "Salesforge", logoKey: "salesforge", ext: "png", heightClass: "h-5 sm:h-6" },
  { name: "Continue", logoKey: "continue", ext: "png", heightClass: "h-6 sm:h-7" },
  { name: "Ulai", logoKey: "ulai", ext: "png", heightClass: "h-7 sm:h-8" },
];
const doubleLogos = [...logos, ...logos, ...logos, ...logos];
---

<section aria-label="Trusted by" class="border-y border-[color:var(--color-border)] bg-white py-8 sm:py-10">
  <div class="mx-auto w-full max-w-[1280px] px-5 sm:px-8">
    <p class="text-center text-[13px] font-medium tracking-[0.08em] uppercase text-[color:var(--color-ink-secondary)] opacity-80">
      Trusted by GTM teams shipping pipeline, not busywork
    </p>
    <div class="marquee mt-8">
      <div class="marquee__track gap-16 sm:gap-20">
        {doubleLogos.map((logo) => (
          <div class="flex items-center justify-center whitespace-nowrap opacity-65 hover:opacity-100 transition-opacity duration-200">
            <img
              src={`/logos/${logo.logoKey}.${logo.ext}`}
              alt={`${logo.name} Logo`}
              class:list={["w-auto object-contain filter grayscale contrast-125 hover:grayscale-0 transition-all duration-300", logo.heightClass]}
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
