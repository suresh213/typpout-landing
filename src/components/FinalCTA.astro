---
import { SITE } from "../data/site";
---

<!-- Bullet list section -->
<section class="mx-auto w-full max-w-[1280px] border-x border-[color:var(--color-border)]">
  <div class="flex flex-col gap-16 border-b border-[color:var(--color-border)] px-4 py-20 md:px-10 md:py-28">
    <div class="flex flex-col gap-12 lg:flex-row lg:items-start lg:gap-20" data-reveal>
      <div class="flex flex-col gap-5 lg:w-[45%]">
        <h2 class="font-display text-2xl font-medium sm:text-3xl lg:text-[40px] leading-tight tracking-tight">
          You solved building.<br class="hidden md:block" /> Let Typpout solve distribution.
        </h2>
        <p class="text-base font-light leading-relaxed text-[color:var(--color-ink-secondary)]">
          You didn't start vibe coding to spend weekends lurking Reddit and writing cold DMs. Typpout replaces the entire grind with four agents that just do it. You ship. They find the users.
        </p>
      </div>
      <ul class="flex flex-col gap-4 lg:flex-1">
        {[
          "Scan LinkedIn, X, and Reddit for buying signals 24/7",
          "Auto-match prospects to your vibe-coded product",
          "Send custom outreach in your natural voice",
          "AI replies in 8 seconds to drive conversions",
          "Focus on shipping while agents find your users",
        ].map((item) => (
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-brand)]">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 13l4 4L19 7" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="text-base font-light leading-relaxed text-[color:var(--color-ink-secondary)]">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- Dark CTA section -->
<section class="mx-auto w-full max-w-[1280px] border-x border-[color:var(--color-border)]">
  <div class="bg-[color:var(--color-surface-dark)] px-4 py-20 md:px-10 md:py-28">
    <div class="flex flex-col items-center gap-8 text-center" data-reveal>
      <div class="space-y-4">
        <h2 class="font-display text-2xl font-medium text-white sm:text-3xl lg:text-[40px] leading-tight tracking-tight">
          Your first 1,000 users are already out there<br class="hidden md:block" /> asking for what you built.
        </h2>
        <p class="mx-auto max-w-lg text-base font-light leading-relaxed text-white/60">
          You did the hard part. Now let the agents find the people who need it.
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a
          href={SITE.appUrl}
          class="inline-flex items-center gap-2 rounded-xl bg-[color:var(--color-brand)] px-6 py-2.5 text-[14px] font-semibold text-white transition-colors hover:bg-[color:var(--color-brand-strong)]"
        >
          Get my first users →
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a
          href={SITE.demoUrl}
          class="inline-flex items-center gap-2 rounded-xl border border-white/20 px-6 py-2.5 text-[14px] font-semibold text-white transition-colors hover:bg-white/10"
        >
          See a live demo
        </a>
      </div>
    </div>
  </div>
</section>
