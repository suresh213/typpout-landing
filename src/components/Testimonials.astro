---
const testimonials = [
  {
    text: "The social listening agent and AI reply agent are perfect for our GTM motions. They efficiently help us book 20+ meetings monthly without any manual prospecting.",
    name: "Santosh Patil",
    handle: "@santoshpatil",
    role: "CEO",
    init: "SP",
    size: "large",
    badge: "20+ meetings / mo",
  },
  {
    text: "Typpout feels different, it's built for PMMs and GTM teams, not just sales. The ICP Finder alone saves me hours every week. I stopped using Apollo entirely.",
    name: "Raiyaan Akhtar",
    handle: "@raiyaan_gtm",
    role: "GTM Lead, Carpl.AI",
    init: "RA",
    size: "medium",
  },
  {
    text: "Instead of juggling 4-5 different tools, my team now finds ICPs, generates content, and runs outreach in one place. We booked 10 qualified meetings in the first two weeks.",
    name: "Swapnil",
    handle: "@swapnil_mktg",
    role: "CEO, DigiMatrix Marketing",
    init: "SW",
    size: "large",
    badge: "10 meetings in 2 wks",
  },
  {
    text: "Speed matters. Typpout helped us move from idea to pipeline in days. The AI outreach felt personal, we closed our first 3 customers directly from campaigns.",
    name: "Sanskar Pitta",
    handle: "@sanskarpitta",
    role: "Netmetschek Group",
    init: "SK",
    size: "small",
  },
  {
    text: "We were spending 3 hours a day manually monitoring LinkedIn. Typpout cut that to zero and the quality of leads went up. The ICP matching is genuinely impressive.",
    name: "Priya Mehta",
    handle: "@priyamehta_rev",
    role: "Head of Revenue",
    init: "PM",
    size: "medium",
  },
  {
    text: "Our reply rate jumped from 12% to 47% within the first month. The AI replies are fast and on-brand, prospects can't even tell it's automated until they're already on the calendar.",
    name: "James Okafor",
    handle: "@jamesokafor",
    role: "VP Sales, Growthbase",
    init: "JO",
    size: "large",
    badge: "47% Reply Rate",
  },
  {
    text: "I was skeptical about AI outreach tools but Typpout actually delivers. It picked up a competitor switch signal on X and booked a demo before we even knew the prospect existed.",
    name: "Lauren Park",
    handle: "@laurenpark_gtm",
    role: "Demand Gen Manager",
    init: "LP",
    size: "medium",
  },
  {
    text: "Finally a GTM tool that doesn't feel like it was designed for a 100-person sales team. Perfect for our lean 3-person GTM team. We punch way above our weight now.",
    name: "Marcus Webb",
    handle: "@marcuswebb",
    role: "Founder, Synthos",
    init: "MW",
    size: "small",
  },
  {
    text: "The funding signal detection is a game changer. We get notified within minutes when a target account closes a round, and the outreach goes out while the news is still fresh.",
    name: "Divya Rao",
    handle: "@divyarao_sales",
    role: "Sales Director",
    init: "DR",
    size: "medium",
  },
];

const cardThemes = [
  { bg: "#eef4ff", accent: "#1a6cf6", initBg: "#c7dbff", initText: "#1a4fa0", badgeBg: "#dbeafe", badgeText: "#1e40af" }, // Blue
  { bg: "#fdf2f8", accent: "#db2777", initBg: "#fce7f3", initText: "#9d174d", badgeBg: "#fce7f3", badgeText: "#9d174d" }, // Pink
  { bg: "#f3eeff", accent: "#7c3aed", initBg: "#ddd6fe", initText: "#5b21b6", badgeBg: "#ddd6fe", badgeText: "#5b21b6" }, // Purple
  { bg: "#ecfdf5", accent: "#059669", initBg: "#a7f3d0", initText: "#065f46", badgeBg: "#a7f3d0", badgeText: "#065f46" }, // Green
  { bg: "#fffbeb", accent: "#d97706", initBg: "#fde68a", initText: "#92400e", badgeBg: "#fde68a", badgeText: "#92400e" }, // Amber
];
---

<section class="mx-auto w-full max-w-[1280px] border-x border-[color:var(--color-border)]">
  <div class="flex flex-col gap-16 border-b border-[color:var(--color-border)] px-4 py-20 md:px-10 md:py-28">

    <div data-reveal>
      <h2 class="font-display text-2xl font-medium sm:text-3xl lg:text-[40px] tracking-tight">
        Proof in Practice
      </h2>
      <p class="mt-3 max-w-md text-base font-light text-[color:var(--color-ink-secondary)]">
        Bold claims are easy. Real results are harder. Here's what GTM teams actually say.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6 items-stretch">
      {testimonials.map((t, i) => {
        const delays = ["", "delay-75", "delay-150", "delay-200", "delay-250", "delay-300", "delay-450", "delay-600"];
        const theme = cardThemes[i % cardThemes.length];

        return (
          <div
            class:list={[
              "flex flex-col justify-between h-full rounded-3xl p-6 sm:p-7 shadow-xs hover:-translate-y-1 hover:shadow-md transition-all duration-300",
              delays[i % delays.length]
            ]}
            style={`background-color: ${theme.bg};`}
            data-reveal
          >
            <div>
              <!-- Top Row: Avatar info + Badge/Twitter -->
              <div class="mb-4 flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <span
                    class="grid h-9 w-9 shrink-0 place-items-center rounded-full text-[11px] font-bold"
                    style={`background-color: ${theme.initBg}; color: ${theme.initText};`}
                  >
                    {t.init}
                  </span>
                  <div>
                    <div class="text-[13.5px] font-semibold text-[color:var(--color-ink-strong)]">
                      {t.name}
                    </div>
                    <div class="text-[11px] text-[color:var(--color-ink-muted)]">{t.handle} · {t.role}</div>
                  </div>
                </div>

                <div class="flex items-center gap-2">
                  {t.badge && (
                    <span
                      class="hidden xs:inline-flex rounded-full px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider"
                      style={`background-color: ${theme.badgeBg}; color: ${theme.badgeText};`}
                    >
                      {t.badge}
                    </span>
                  )}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-[color:var(--color-ink-subtle)] opacity-70" aria-hidden="true">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.738l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                </div>
              </div>

              <!-- Quote Text -->
              <p class="text-[13.5px] sm:text-[14px] leading-relaxed text-[color:var(--color-ink-strong)]">
                "{t.text}"
              </p>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>

