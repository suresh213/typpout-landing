---
interface FAQItem {
  q: string;
  a: string;
}
interface Props {
  items?: FAQItem[];
  title?: string;
  subtitle?: string;
}

const defaultFaqs: FAQItem[] = [
  {
    q: "What is Typpout, in one sentence?",
    a: "Typpout is a self-learning AI GTM platform that orchestrates custom core AI models across listening, enrichment, outreach, and reply-handling workflows feeding all conversion data into a compounding GTM Brain.",
  },
  {
    q: "Which platforms does Typpout listen on?",
    a: "LinkedIn, X (Twitter) and Instagram are supported today, with TikTok, Reddit and YouTube on the roadmap. We track posts, comments, reactions, and DM signals in real time using native NLP models.",
  },
  {
    q: "How is this different from a sales engagement tool like HeyReach or Apollo?",
    a: "Tools like HeyReach automate volume; Typpout automates relevance using core AI. We monitor live buying signals and use a self-learning brain to personalize our touchpoints, achieving 3-5x higher response rates than legacy databases.",
  },
  {
    q: "How is Typpout different from Jeeva AI or Orange Slice?",
    a: "Jeeva is great at scaled SDR sequences but doesn't ingest social signals natively. Orange Slice focuses on social CRM. Typpout is the only platform that combines core AI listening, vector ICP matching, outreach AND semantic replying in one unified stack.",
  },
  {
    q: "Will the AI sound like a bot?",
    a: "No. Typpout's generative writing agents use grounded prompts contextually based on the prospect's live post and company profiles. As the GTM brain accumulates reply histories, its writing model automatically aligns and sounds highly personalized.",
  },
  {
    q: "Is there a free trial?",
    a: "Yes - every plan comes with a 3-day free trial. No credit card required. Cancel anytime.",
  },
  {
    q: "How quickly can I see meetings booked?",
    a: "Most customers book their first qualified meeting within the first week. Our Done-For-You plan guarantees 15 meetings per month.",
  },
  {
    q: "Is my data safe?",
    a: "Yes. All credentials are encrypted at rest, social tokens are stored in a SOC 2 Type II-certified vault, and we never sell or share your data. Read our security page for full details.",
  },
];

const {
  items = defaultFaqs,
  title = "Frequently asked questions",
  subtitle = "Everything you need to know about Typpout, GTM signals, and how the AI agents work.",
} = Astro.props;

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<section id="faq" class="mx-auto w-full max-w-[1280px] border-x border-[color:var(--color-border)]">
  <div class="px-5 py-24 sm:px-8 lg:py-32">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_1.5fr] lg:gap-16">
      <div class="lg:sticky lg:top-24 lg:self-start" data-reveal>
        <span class="eyebrow">FAQ</span>
        <h2 class="h-section mt-4">{title}</h2>
        <p class="mt-5 max-w-md text-[17px] leading-relaxed text-[color:var(--color-foreground-secondary)]">
          {subtitle}
        </p>
      </div>

      <div class="divide-y divide-[color:var(--color-border)] border-y border-[color:var(--color-border)]" data-reveal>
        {items.map((f, i) => (
          <details class="group py-5" name="faq" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6">
              <span class="text-[18px] font-medium text-[color:var(--color-foreground)] transition-colors duration-200 group-hover:text-[color:var(--color-brand)]">{f.q}</span>
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-[color:var(--color-border)] transition-all duration-300 group-open:rotate-45 group-hover:border-[color:var(--color-brand)]/40 group-hover:bg-[color:var(--color-brand-50)]">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-[color:var(--color-foreground-secondary)]">
              {f.a}
            </p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
