---
interface FAQItem {
  q: string;
  a: string;
}
interface Props {
  items?: FAQItem[];
  title?: string;
  subtitle?: string;
}

const defaultFaqs: FAQItem[] = [
  {
    q: "What is Typpout?",
    a: "The GTM layer for vibe-coded products — agents that find people asking for what you built, reach out in your voice, and turn it into signups.",
  },
  {
    q: "Who's it for?",
    a: "Indie hackers and solo founders who shipped fast with Lovable, Bolt, Cursor, or Replit and now have a great product and an empty user count.",
  },
  {
    q: "Which platforms?",
    a: "LinkedIn, X (Twitter), and Reddit today; Product Hunt and GitHub for technical products.",
  },
  {
    q: "Isn't this spam?",
    a: "No. Typpout only reaches out on real fit, and every message references what the person actually posted. You can approve every message before it goes out, or set precise guardrails and let the agents run automatically.",
  },
  {
    q: "How's it different from 11x or Artisan?",
    a: "Those blast massive volume from purchased cold lists for enterprise sales teams. Typpout finds people who are publicly asking for exactly what you made in real-time — at a price a solo founder can actually pay.",
  },
  {
    q: "Do I need to know marketing?",
    a: "No. Simply connect your product, set your outreach voice, and let the agents run the GTM motion automatically in the background.",
  },
  {
    q: "Is there a free trial?",
    a: "Yes. Every plan comes with a 3-day free trial. No credit card required. You can see real prospects and signals matching your product within 5 minutes.",
  },
  {
    q: "Is my data safe?",
    a: "Yes. Public posts and your product spec details only. We never sell your data, nor do we ever use it to train models. All credentials are fully encrypted.",
  },
];

const {
  items = defaultFaqs,
  title = "Frequently asked questions",
  subtitle = "Everything you need to know about Typpout, GTM signals, and how the AI agents work.",
} = Astro.props;

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<section id="faq" class="mx-auto w-full max-w-[1280px] border-x border-[color:var(--color-border)]">
  <div class="px-5 py-24 sm:px-8 lg:py-32">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_1.5fr] lg:gap-16">
      <div class="lg:sticky lg:top-24 lg:self-start" data-reveal>
        <span class="eyebrow">FAQ</span>
        <h2 class="h-section mt-4">{title}</h2>
        <p class="mt-5 max-w-md text-[17px] leading-relaxed text-[color:var(--color-foreground-secondary)]">
          {subtitle}
        </p>
      </div>

      <div class="divide-y divide-[color:var(--color-border)] border-y border-[color:var(--color-border)]" data-reveal>
        {items.map((f, i) => (
          <details class="group py-5" name="faq" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6">
              <span class="text-[18px] font-medium text-[color:var(--color-foreground)] transition-colors duration-200 group-hover:text-[color:var(--color-brand)]">{f.q}</span>
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-[color:var(--color-border)] transition-all duration-300 group-open:rotate-45 group-hover:border-[color:var(--color-brand)]/40 group-hover:bg-[color:var(--color-brand-50)]">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-[color:var(--color-foreground-secondary)]">
              {f.a}
            </p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
