---
interface Props {
  class?: string;
  size?: "sm" | "md" | "lg";
  loading?: "eager" | "lazy";
}
const { class: className = "", size = "md", loading = "lazy" } = Astro.props;

const dims = {
  sm: { height: 30, width: 82, class: "h-[30px] w-auto" },
  md: { height: 38, width: 104, class: "h-[38px] w-auto" },
  lg: { height: 46, width: 126, class: "h-[46px] w-auto" },
}[size];
---

<a href="/" aria-label="Typpout home" class={`group inline-flex items-center ${className}`}>
  <img
    src="/typpout-acquired-logo.png"
    alt="Typpout - Acquired by sprouts.ai"
    width={dims.width}
    height={dims.height}
    class={`${dims.class} max-w-none object-contain`}
    loading={loading}
  />
</a>
