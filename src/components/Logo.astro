---
interface Props {
  class?: string;
  size?: "sm" | "md" | "lg";
  loading?: "eager" | "lazy";
}
const { class: className = "", size = "md", loading = "lazy" } = Astro.props;

const dims = {
  sm: { height: 28, width: 77, class: "h-[28px] w-auto" },
  md: { height: 36, width: 99, class: "h-[32px] sm:h-[36px] w-auto" },
  lg: { height: 44, width: 121, class: "h-[38px] sm:h-[44px] w-auto" },
}[size];
---

<a href="/" aria-label="Typpout home" class={`group inline-flex items-center ${className}`}>
  <img
    src="/typpout-acquired-logo.png"
    alt="Typpout - Acquired by sprouts.ai"
    width={dims.width}
    height={dims.height}
    class={`${dims.class} max-w-none object-contain`}
    loading={loading}
  />
</a>
