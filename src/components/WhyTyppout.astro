---
import { SITE } from "../data/site";
---

<section class="mx-auto w-full max-w-[1280px] border-x border-[color:var(--color-border)]">

  <!-- Pain section - left text + right stacked pills (matches template layout exactly) -->
  <div class="overflow-x-clip bg-secondary flex flex-col items-start justify-between border-b border-[color:var(--color-border)] py-20 md:py-28 lg:flex-row lg:items-center">
    <div class="p-4 md:p-12" data-reveal>
      <h2 class="font-display text-2xl font-medium sm:text-3xl lg:text-[40px] leading-tight tracking-tight text-[color:var(--color-ink)]">
        You're running a go-to-market team.
      </h2>
      <h2 class="font-display mt-2 max-w-lg text-2xl font-medium sm:text-3xl lg:text-[40px] leading-tight tracking-tight text-[color:var(--color-ink-secondary)] opacity-50">
        Why is your GTM data still static?
      </h2>
      <p class="mt-6 max-w-lg text-base font-light leading-relaxed text-[color:var(--color-ink-secondary)]">
        Typpout integrates proprietary, core AI models into every step of your GTM workflows. Every listening trigger, ICP match, outreach draft, and reply is managed by our compounding GTM Brain getting stronger and smarter with every single outreach.
      </p>
    </div>

    <div class="ml-auto flex w-full flex-col gap-5 pl-6 sm:w-1/3 sm:max-w-xl sm:pl-0" data-reveal>
      {[
        { label: "AI Social Listening", iconBg: "bg-emerald-50 border-emerald-100/60 text-emerald-600 group-hover:bg-emerald-100 group-hover:border-emerald-200", icon: "radar" },
        { label: "Agents to track LLM searches", iconBg: "bg-pink-50 border-pink-100/60 text-pink-600 group-hover:bg-pink-100 group-hover:border-pink-200", icon: "eye" },
        { label: "Heuristic ICP Matcher", iconBg: "bg-blue-50 border-blue-100/60 text-blue-600 group-hover:bg-blue-100 group-hover:border-blue-200",    icon: "users" },
        { label: "Grounded AI Outreach",  iconBg: "bg-purple-50 border-purple-100/60 text-purple-600 group-hover:bg-purple-100 group-hover:border-purple-200", icon: "message" },
        { label: "Semantic AI Booking",   iconBg: "bg-orange-50 border-orange-100/60 text-orange-600 group-hover:bg-orange-100 group-hover:border-orange-200", icon: "bolt" },
      ].map((f) => (
        <div class="slide-in-left flex w-full items-center gap-4 rounded-l-2xl border border-r-0 border-stone-200/80 bg-white py-4 pl-6 pr-6 text-stone-800 shadow-[0_2px_8px_-3px_rgba(0,0,0,0.05)] transition-all duration-300 hover:bg-stone-50/50 hover:translate-x-[-8px] hover:shadow-md cursor-pointer group">
          <div class:list={["flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border transition-all duration-200", f.iconBg]}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="shrink-0" aria-hidden="true">
              {f.icon === "radar"   && <><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="7" stroke="currentColor" stroke-width="2"/><path d="M12 5v-2M12 21v-2" stroke="currentColor" stroke-width="2"/></>}
              {f.icon === "users"   && <><circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="2"/><path d="M3 20c0-3 3-5 6-5s6 2 6 5M16 11a3 3 0 100-6M21 20c0-2.5-2-4-4.5-4.5" stroke="currentColor" stroke-width="2"/></>}
              {f.icon === "message" && <path d="M4 6a2 2 0 012-2h12a2 2 0 012 2v9a2 2 0 01-2 2H9l-5 4V6z" stroke="currentColor" stroke-width="2"/>}
              {f.icon === "bolt"    && <path d="M13 2L4 14h7l-2 8 10-12h-7l1-8z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>}
              {f.icon === "eye"     && <><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/></>}
            </svg>
          </div>
          <span class="font-display text-[17px] font-semibold text-stone-700 tracking-tight transition-colors group-hover:text-stone-900">{f.label}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Clay-style full-width feature cards with testimonials -->
  <div class="flex flex-col gap-4 px-4 pt-16 pb-8 md:px-8 md:pt-24 md:pb-10">
    <div class="mx-auto max-w-xl space-y-4 text-center mb-12" data-reveal>
      <h2 class="font-display text-2xl font-medium sm:text-3xl lg:text-[40px] tracking-tight">
        Turn the social conversations<br class="hidden md:block" /> into real revenue
      </h2>
      <p class="text-base font-light text-[color:var(--color-ink-secondary)]">
        Ditch static databases. Leverage self-learning models that make your GTM Brain sharper and more conversion-focused with every touchpoint.
      </p>
    </div>

    {[
      {
        step: "01",
        label: "SOCIAL LISTENING AGENT",
        title: "Catch buyers",
        titleAccent: "the moment they signal",
        desc: "Deep NLP models scan LinkedIn, X, and Instagram 24/7 for buying intent, competitor mentions, and hiring signals parsing conversation context in real time so you never miss an in-market moment.",
        accent: "#1a6cf6",
        bg: "#eef4ff",
        pillBg: "#c7dbff",
        pillText: "#1a4fa0",
        testimonial: {
          quote: "Typpout surfaced a prospect who posted about switching tools. We replied within minutes and booked a call that same day.",
          name: "James R.",
          role: "Head of Growth · Synthos",
          initials: "JR",
          avatarBg: "#1a6cf6",
        },
        preview: [
          { label: "in", text: "anyone using social listening for B2B? cold email is dead", bg: "#0A66C2" },
          { label: "𝕏", text: "moving off Apollo, looking for something signal-first", bg: "#000000" },
          { label: "r/", text: "evaluating AI SDR tools this week any recs?", bg: "#FF4500" },
        ],
        previewType: "signals",
      },
      {
        step: "02",
        label: "AI VISIBILITY AGENT",
        title: "Agents to track",
        titleAccent: "LLM searches.",
        desc: "Gain complete transparency into how AI engines perceive, reference, and score your product across every model, prompt, and competitor.",
        accent: "#db2777",
        bg: "#fdf2f8",
        pillBg: "#fce7f3",
        pillText: "#9d174d",
        testimonial: {
          quote: "We now know exactly which sources Claude and ChatGPT pull to recommend us. Our AI share of voice grew by 35% in a single month.",
          name: "Helen K.",
          role: "Head of Marketing · Voxel",
          initials: "HK",
          avatarBg: "#db2777",
        },
        preview: [
          { text: "Agents to track LLM searches.", bold: true },
          { text: "Track visibility across every prompt & model." },
          { text: "Understand where AI gets its information." },
          { text: "Search, tag, and organize your prompts." },
          { text: "See how you stack up against the competition." },
          { text: "Inspect every individual AI response." },
        ],
        previewType: "visibility",
      },
      {
        step: "03",
        label: "ICP MATCHING AGENT",
        title: "Find the exact right",
        titleAccent: "buyer every time",
        desc: "Semantic vector scoring compares every signal against your ICP criteria. Data enrichment waterfalls hit 50+ providers in milliseconds so you act on fully-enriched, accurate contact profiles not stale CSVs.",
        accent: "#7c3aed",
        bg: "#f3eeff",
        pillBg: "#ddd6fe",
        pillText: "#5b21b6",
        testimonial: {
          quote: "Our ICP match accuracy jumped from 60% to 94% in the first two weeks. The waterfall enrichment alone saved us 20 hours a week.",
          name: "Priya S.",
          role: "VP Sales · Northbeam",
          initials: "PS",
          avatarBg: "#7c3aed",
        },
        preview: [
          { name: "Sarah Kim", title: "VP Sales · Growthbase", score: "97%", init: "SK", scoreColor: "color:#059669" },
          { name: "Marcus Webb", title: "Head of Revenue · Synthos", score: "93%", init: "MW", scoreColor: "color:#2563eb" },
          { name: "Priya Shah", title: "PMM · Northbeam", score: "91%", init: "PS", scoreColor: "color:#7c3aed" },
        ],
        previewType: "icp",
      },
      {
        step: "04",
        label: "AI OUTREACH AGENT",
        title: "Messages that feel",
        titleAccent: "genuinely personal",
        desc: "Generative AI synthesizes live signal context, prospect technographics, and your value proposition into a bespoke first touch grounded in exactly what triggered the match. Zero templates. Zero cringe.",
        accent: "#059669",
        bg: "#ecfdf5",
        pillBg: "#a7f3d0",
        pillText: "#065f46",
        testimonial: {
          quote: "I couldn't believe an AI wrote those messages. Our reply rate went from 4% to 41% in 3 weeks.",
          name: "Maya T.",
          role: "Founder · Growthbase",
          initials: "MT",
          avatarBg: "#059669",
        },
        preview: [
          { sender: "prospect", text: "outbound email is dead in 2026, nothing gets a reply anymore..." },
          { sender: "ai", text: "Saw your post Maya we built Typpout exactly for this. Worth a 5-min call?" },
        ],
        previewType: "outreach",
      },
      {
        step: "05",
        label: "AI BOOKING AGENT",
        title: "Replies in 8s.",
        titleAccent: "Meetings in minutes.",
        desc: "Multi-turn dialogue models handle pricing objections, answer product questions, and schedule calendar events without human intervention. Every conversation feeds back into the GTM Brain.",
        accent: "#d97706",
        bg: "#fffbeb",
        pillBg: "#fde68a",
        pillText: "#92400e",
        testimonial: {
          quote: "The AI replied to a prospect at 2am, handled their pricing question, and booked a demo for the next morning. I woke up to a confirmed meeting.",
          name: "Carlos M.",
          role: "CEO · PipelineOS",
          initials: "CM",
          avatarBg: "#d97706",
        },
        preview: [
          { status: "success", text: "Meeting booked ✓ Wed 3:30 PM", desc: "replied in 8s" },
          { status: "info", text: "Handled objection · Follow-up sent", desc: "objection: pricing" },
          { status: "success", text: "Demo confirmed · Calendar invite sent", desc: "auto-booked" },
        ],
        previewType: "reply",
      },
    ].map((f, i) => (
      <div
        class="overflow-hidden rounded-3xl"
        style={`background:${f.bg}; position: sticky; top: ${80 + i * 40}px; z-index: ${(i + 1) * 10};`}
        data-reveal
      >
        <div class="flex flex-col lg:flex-row lg:min-h-[520px]">

          <!-- Left: Text Panel -->
          <div class="flex flex-1 flex-col justify-between gap-10 p-8 md:p-14 lg:max-w-[52%]">
            <div class="space-y-6">
              <!-- Label pill -->
              <div
                class="inline-flex items-center rounded-md px-2.5 py-1 text-[11px] font-semibold tracking-[0.08em] uppercase"
                style={`background:${f.pillBg}; color:${f.pillText};`}
              >
                {f.label}
              </div>

              <!-- Heading -->
              <h3
                class="font-display text-[34px] leading-[1.08] sm:text-[42px] lg:text-[48px]"
                style="font-weight: 400; letter-spacing: -1.5px; color: #0f172a;"
              >
                {f.title}<br />
                <span style={`color:${f.accent}; font-weight: 400;`}>{f.titleAccent}</span>
              </h3>

              <!-- Description -->
              <p style="max-width: 340px; font-size: 15px; font-weight: 400; line-height: 1.65; color: #374151;">
                {f.desc}
              </p>
            </div>

            <!-- Testimonial -->
            <div class="space-y-2.5">
              <!-- Avatar row -->
              <div class="flex items-center gap-2">
                <div
                  class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-[10px] text-white"
                  style={`background:${f.testimonial.avatarBg}; font-weight: 700;`}
                >
                  {f.testimonial.initials}
                </div>
              </div>
              <!-- Quote -->
              <p style="font-size: 13px; font-weight: 400; line-height: 1.55; color: #111827; max-width: 320px;">
                <strong style="font-weight: 700;">{f.testimonial.name}</strong>{" "}{f.testimonial.quote}
              </p>
            </div>

            <!-- CTA -->
            <div class="flex flex-wrap items-center gap-4">
              <a
                href={SITE.appUrl}
                class="inline-flex items-center gap-2 rounded-xl px-6 py-3 text-[14px] font-semibold text-white transition-opacity hover:opacity-90"
                style={`background:${f.accent}`}
              >
                Start free trial
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              <a href="/#features" class="text-[14px] font-medium text-stone-500 hover:text-stone-800 transition-colors">
                Explore feature →
              </a>
            </div>
          </div>

          <!-- Right: Visual Panel -->
          <div class="flex flex-1 items-center justify-center p-6 lg:p-8">
            <div class="w-full max-w-md rounded-2xl bg-white/70 p-5 shadow-[0_8px_40px_rgba(0,0,0,0.08)] backdrop-blur-sm border border-white/80">
              <div class="space-y-2.5">

                {f.previewType === "signals" && f.preview.map((row: any) => (
                  <div class="flex items-center gap-3 rounded-xl border border-stone-100 bg-white px-4 py-3 text-[13px] shadow-xs">
                    <span
                      class="grid h-6 w-6 shrink-0 place-items-center rounded-full text-[10px] font-bold text-white"
                      style={`background:${row.bg}`}
                    >{row.label}</span>
                    <span class="truncate font-medium text-stone-800">{row.text}</span>
                    <span class="ml-auto shrink-0 rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-700">intent</span>
                  </div>
                ))}

                {f.previewType === "icp" && f.preview.map((row: any) => (
                  <div class="flex items-center justify-between gap-3 rounded-xl border border-stone-100 bg-white px-4 py-3 shadow-xs">
                    <div class="flex items-center gap-3">
                      <div class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-stone-100 text-[11px] font-bold text-stone-600">
                        {row.init}
                      </div>
                      <div>
                        <div class="text-[13px] font-semibold text-stone-800 leading-tight">{row.name}</div>
                        <div class="text-[11px] text-stone-500 leading-tight">{row.title}</div>
                      </div>
                    </div>
                    <div class="shrink-0 rounded-full px-2.5 py-1 text-[11px] font-bold bg-white border border-stone-200" style={row.scoreColor}>
                      {row.score}
                    </div>
                  </div>
                ))}

                {f.previewType === "outreach" && f.preview.map((row: any) => (
                  row.sender === "prospect" ? (
                    <div class="flex items-start gap-2">
                      <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-stone-200 text-[10px] font-bold text-stone-600 mt-0.5">P</span>
                      <div class="rounded-2xl rounded-tl-none bg-stone-100 px-4 py-2.5 text-[13px] text-stone-700 leading-relaxed">
                        {row.text}
                      </div>
                    </div>
                  ) : (
                    <div class="flex items-start gap-2 justify-end">
                      <div class="rounded-2xl rounded-tr-none px-4 py-2.5 text-[13px] text-white leading-relaxed shadow-sm" style={`background:${f.accent}`}>
                        {row.text}
                      </div>
                      <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full text-[9px] font-bold text-white mt-0.5" style={`background:${f.accent}`}>AI</span>
                    </div>
                  )
                ))}

                {f.previewType === "reply" && f.preview.map((row: any) => (
                  <div class:list={[
                    "flex items-center justify-between gap-3 rounded-xl border px-4 py-3 text-[13px]",
                    row.status === "success"
                      ? "bg-emerald-50 border-emerald-200 text-emerald-800"
                      : "bg-white border-stone-200 text-stone-700"
                  ]}>
                    <div class="flex items-center gap-2">
                      <span class:list={[
                        "h-2 w-2 rounded-full",
                        row.status === "success" ? "bg-emerald-500 animate-pulse" : "bg-blue-400"
                      ]}></span>
                      <span class="font-semibold">{row.text}</span>
                    </div>
                    <span class="font-mono text-[11px] opacity-60">{row.desc}</span>
                  </div>
                ))}

                {f.previewType === "visibility" && (
                  <div class="space-y-2">
                    <div class="flex items-center justify-between border-b border-stone-150 pb-2 mb-2 text-xs font-bold text-stone-850">
                      <span>Visibility Features</span>
                      <span class="text-[9px] font-bold bg-pink-50 text-pink-600 px-1.5 py-0.5 rounded border border-pink-100">Live tracker</span>
                    </div>
                    {f.preview.map((row: any, rIdx: number) => (
                      <div class:list={[
                        "flex items-center gap-2.5 rounded-xl border px-3 py-2 text-[12px] transition-all duration-200",
                        row.bold 
                          ? "bg-pink-50/50 border-pink-150 text-pink-900 font-semibold" 
                          : "bg-white border-stone-100 text-stone-600 hover:bg-stone-50"
                      ]}>
                        <span class:list={[
                          "flex h-4.5 w-4.5 shrink-0 items-center justify-center rounded-full text-[9px] font-bold",
                          row.bold ? "bg-pink-600 text-white" : "bg-stone-100 text-stone-500"
                        ]}>
                          {rIdx + 1}
                        </span>
                        <span class="truncate">{row.text}</span>
                        {row.bold && (
                          <span class="ml-auto h-1.5 w-1.5 rounded-full bg-pink-500 animate-ping"></span>
                        )}
                      </div>
                    ))}
                  </div>
                )}

              </div>
            </div>
          </div>

        </div>
      </div>
    ))}

  </div>

</section>
