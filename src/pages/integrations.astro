      ]
    },
    mailchimp: {
      steps: [
        "Log into Mailchimp, navigate to **Account > Extras > API Keys**, and generate a new key.",
        "In Typpout, enter your Mailchimp API Key and Audience ID under **Integrations > Mailchimp**.",
        "Choose whether to add matching social prospects to your audience as *Subscribed* or *Pending*.",
        "Select tags (e.g., `Typpout-Lead`, `Social-Intent`) to apply to synced contacts.",
        "Click **Verify & Connect** to start syncing leads into your marketing funnels."
      ]
    },
    zoominfo: {
      steps: [
        "Navigate to **Settings > Integrations** in your Typpout dashboard and select **ZoomInfo**.",
        "Enter your ZoomInfo enterprise API Username, Password, and Client Key.",
        "Set enrichment parameters (e.g., trigger ZoomInfo lookup only when match score > 90%).",
        "Select default fallback fields for missing data.",
        "Click **Test Connection & Save** to start pulling verified phone numbers and corporate emails."
      ]
    },
    outreach: {
      steps: [
        "In Typpout, navigate to **Settings > Integrations** and click **Outreach**.",
        "Click **Authorize Outreach** and sign in with your Outreach admin credentials.",
        "Map your prospects' social handles and signals to Outreach custom prospect fields.",
        "Select the Outreach Sequence (e.g., *Social Intent Sequence*) to trigger when a high-intent signal matches.",
        "Click **Save Sequence Configuration** to enable automated outbound execution."
      ]
    },
    salesloft: {
      steps: [
        "Navigate to **Settings > Integrations > Salesloft** in the Typpout dashboard.",
        "Click **Connect Salesloft** and authorize the application access.",
        "Map Typpout variables (prospect name, title, company, intent signal) to Salesloft fields.",
        "Assign default sales cadences for newly synced prospects.",
        "Activate the integration to dynamically route social leads into live SDR phone and email cadences."
      ]
    },
    gong: {
      steps: [
        "Go to **Settings > Integrations** in Typpout and select **Gong**.",
        "Log in to the Gong developer console, create an API Key, and paste it into Typpout.",
        "Choose which conversation trackers and keywords you want to sync.",
        "Sync call transcripts and metadata automatically to the corresponding lead records in Typpout.",
        "Click **Validate & Enable Sync** to begin parsing meeting conversations for intent signals."
      ]
    },
    sixsense: {
      steps: [
        "Go to **Settings > Integrations > 6sense** in the Typpout dashboard.",
        "Input your 6sense API endpoint and workspace Token.",
        "Configure your account mapping rules to align 6sense intent segments with Typpout GTM agents.",
        "Map account intent scores to alert thresholds inside Typpout.",
        "Toggle **Active Sync** to begin merging anonymous account intent data with social signals."
      ]
    },
    seamless: {
      steps: [
        "Open your Seamless.ai dashboard, go to **Settings > API keys**, and copy your API key.",
        "Paste your API key under **Integrations > Seamless AI** in Typpout.",
        "Define lookup limits (e.g. max 500 email/phone enrichments per day).",
        "Choose default data mapping rules for enriched B2B contacts.",
        "Save settings. Typpout will now automatically query Seamless AI for cell phone numbers when leads are matched."
      ]
    },
    lusha: {
      steps: [
        "Navigate to Lusha Dashboard > Account > API and copy your Lusha API Key.",
        "In Typpout, navigate to **Integrations > Lusha** and enter your API Key.",
        "Set Lusha usage limits and alert thresholds for your API credit usage.",
        "Map the phone and email response fields from Lusha to Typpout contact records.",
        "Click **Save settings** to enable background data enrichment."
      ]
    },
    leadiq: {
      steps: [
        "Log into your LeadIQ dashboard, go to **Developer Settings**, and copy your API access token.",
        "In Typpout, go to **Integrations > LeadIQ** and input the token.",
        "Configure LeadIQ to automatically export contacts to your connected CRM when social intent triggers.",
        "Map LeadIQ target fields to Typpout standard attributes.",
        "Click **Enable LeadIQ Sync** to activate real-time contact creation."
      ]
    },
    kaspr: {
      steps: [
        "Go to Kaspr Dashboard > Settings > API and copy your API Token.",
        "In Typpout, open the **Kaspr Integration Settings** and paste the token.",
        "Map Kaspr's email and phone data fields to Typpout contact attributes.",
        "Configure background lookup rules (e.g. query Kaspr only for LinkedIn signals).",
        "Click **Save** to start fetching direct phone numbers and corporate emails."
      ]
    },
    cognism: {
      steps: [
        "In the Typpout dashboard, click on **Settings > Integrations** and select **Cognism**.",
        "Enter your Cognism API user credentials and corporate token.",
        "Map Cognism contact data objects to Typpout leads.",
        "Select preferred geo-regions (e.g. EU, NA, APAC) for compliant B2B mobile number lookups.",
        "Click **Enable Connection** to begin background enrichment."
      ]
    }
  };

  const filterIntegrations = () => {
    let visibleCount = 0;

    cards.forEach((card) => {
      const cardName = card.getAttribute("data-name") || "";
      const cardDesc = card.getAttribute("data-desc") || "";
      const cardCat = card.getAttribute("data-category") || "";

      const matchesSearch = cardName.includes(currentSearch) || cardDesc.includes(currentSearch);
      const matchesCategory = currentCategory === "all" || cardCat === currentCategory;

      if (matchesSearch && matchesCategory) {
        (card as HTMLElement).style.display = "flex";
        visibleCount++;
      } else {
        (card as HTMLElement).style.display = "none";
      }
    });

    if (emptyState) {
      if (visibleCount === 0) {
        emptyState.classList.remove("hidden");
      } else {
        emptyState.classList.add("hidden");
      }
    }
  };

  const updateActiveButton = () => {
    filterBtns.forEach((btn) => {
      const cat = btn.getAttribute("data-filter");
      if (cat === currentCategory) {
        btn.classList.add("bg-[color:var(--color-brand-50)]", "text-[color:var(--color-brand-on-light)]", "border-[color:var(--color-brand-200)]");
        btn.classList.remove("text-[color:var(--color-ink-secondary)]", "border-transparent");
      } else {
        btn.classList.remove("bg-[color:var(--color-brand-50)]", "text-[color:var(--color-brand-on-light)]", "border-[color:var(--color-brand-200)]");
        btn.classList.add("text-[color:var(--color-ink-secondary)]");
        if (btn.tagName === "BUTTON" && !btn.classList.contains("lg:flex")) {
          btn.classList.add("border-[color:var(--color-border)]");
        }
      }
    });
  };

  searchInput?.addEventListener("input", (e) => {
    currentSearch = (e.target as HTMLInputElement).value.toLowerCase().trim();
    filterIntegrations();
  });

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.getAttribute("data-filter");
      if (filter) {
        currentCategory = filter;
        updateActiveButton();
        filterIntegrations();
      }
    });
  });

  // Modal logic
  const modal = document.getElementById("docs-modal");
  const modalTitle = document.getElementById("modal-title");
  const modalLogo = document.getElementById("modal-logo") as HTMLImageElement | null;
  const modalCategory = document.getElementById("modal-category");
  const modalSteps = document.getElementById("modal-steps");
  const closeModalBtn = document.getElementById("close-modal-btn");
  const modalSecondaryBtn = document.getElementById("modal-secondary-btn");
  const docsTriggers = document.querySelectorAll("[data-docs-trigger]");

  docsTriggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const el = trigger as HTMLElement;
      const key = el.dataset.vendorKey || "";
      const name = el.dataset.vendorName || "";
      const logo = el.dataset.vendorLogo || "";
      const category = el.dataset.vendorCategory || "";

      if (modalTitle) modalTitle.textContent = `${name} Setup`;
      if (modalCategory) modalCategory.textContent = category;
      if (modalLogo) {
        modalLogo.src = `/logos/${logo}.webp`;
        modalLogo.alt = `${name} Logo`;
      }

      if (modalSteps) {
        modalSteps.innerHTML = "";
        const data = docData[key as keyof typeof docData];
        if (data && data.steps) {
          data.steps.forEach((step, idx) => {
            const li = document.createElement("li");
            li.className = "flex gap-3 items-start text-sm text-[color:var(--color-ink-secondary)] leading-relaxed";
            const formattedStep = step.replace(/\*\*(.*?)\*\//g, "<strong>$1</strong>").replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");
            li.innerHTML = `
              <span class="flex h-5 w-5 shrink-0 select-none items-center justify-center rounded-full bg-[color:var(--color-brand-50)] text-[10px] font-bold text-[color:var(--color-brand-on-light)] border border-[color:var(--color-brand-100)] mt-0.5">
                ${idx + 1}
              </span>
              <p class="flex-1">${formattedStep}</p>
            `;
            modalSteps.appendChild(li);
          });
        } else {
          modalSteps.innerHTML = `<li class="text-xs text-[color:var(--color-ink-muted)]">Setup documentation for this integration is coming soon.</li>`;
        }
      }

      if (modal) {
        modal.classList.remove("opacity-0", "pointer-events-none");
        const modalContainer = modal.firstElementChild as HTMLElement;
        if (modalContainer) {
          modalContainer.classList.remove("translate-y-4");
          modalContainer.classList.add("translate-y-0");
        }
      }
    });
  });

  const closeModal = () => {
    if (modal) {
      modal.classList.add("opacity-0", "pointer-events-none");
      const modalContainer = modal.firstElementChild as HTMLElement;
      if (modalContainer) {
        modalContainer.classList.remove("translate-y-0");
        modalContainer.classList.add("translate-y-4");
      }
    }
  };

  closeModalBtn?.addEventListener("click", closeModal);
  modalSecondaryBtn?.addEventListener("click", closeModal);
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeModal();
    }
  });

  updateActiveButton();
</script>
