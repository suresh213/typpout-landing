const integrationsLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": SITE.url
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Integrations",
          "item": `${SITE.url}/integrations`
        }
      ]
    },
    {
      "@type": "WebPage",
      "name": "Typpout Integrations",
      "description": "Explore Typpout's native integrations across CRMs, Social Selling channels, Lead enrichment systems, and Email outreach workflows.",
      "url": `${SITE.url}/integrations`,
    }
  ]
};
---

<Layout
  title="Integrations - Connected to your entire GTM stack"
  description="Connect Typpout seamlessly with HubSpot, Salesforce, Slack, Clay, Apollo, LinkedIn, ZoomInfo, and email providers to automate your GTM pipeline."
  keywords={["Typpout integrations", "CRM integrations for SDR", "HubSpot sales integrations", "Slack sales alert integration", "Clay enrichment workflow sync"]}
  jsonLd={integrationsLd}
>
  <div class="mx-auto w-full max-w-[1280px] border-x border-[color:var(--color-border)] min-h-screen bg-white">
    <!-- Hero Section -->
    <section class="border-b border-[color:var(--color-border)] bg-[color:var(--color-surface-muted)]">
      <div class="px-5 py-20 text-center sm:px-8 lg:py-24">
        <span class="eyebrow">Integrations</span>
        <h1 class="h-section mt-4 text-balance">
          Connected to your
          <span class="font-display-italic text-[color:var(--color-foreground-secondary)]"> entire GTM stack.</span>
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-[17px] leading-relaxed text-[color:var(--color-ink-secondary)]">
          Sync data seamlessly, capture intent signals, and automate outreach across all your favorite sales, CRM, and marketing tools.
        </p>
      </div>
    </section>

    <!-- Search & Filters Container -->
    <section class="py-12 px-5 sm:px-8 border-b border-[color:var(--color-border)]">
      <!-- Search Input -->
      <div class="mb-10 max-w-md mx-auto relative">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
          <svg class="h-5 w-5 text-[color:var(--color-ink-muted)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          id="search-input"
          placeholder="Search integrations by name or description..."
          class="block w-full rounded-xl border border-[color:var(--color-border)] bg-white py-3 pl-10 pr-4 text-sm placeholder-[color:var(--color-ink-muted)] text-[color:var(--color-ink-strong)] outline-none transition-all focus:border-[color:var(--color-brand)] focus:ring-1 focus:ring-[color:var(--color-brand)] focus:shadow-[0_0_12px_rgba(124,90,197,0.1)]"
        />
      </div>

      <!-- Main Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-[240px_1fr] gap-8 items-start">
        <!-- Sidebar Navigation Filters (Desktop & Mobile) -->
        <div class="lg:sticky lg:top-24">
          <!-- Desktop Category Filters -->
          <ul class="hidden lg:flex flex-col gap-1">
            {categories.map((cat) => (
              <li>
                <button
                  data-filter={cat.id}
                  class="filter-btn w-full text-left rounded-lg px-4 py-2.5 text-sm font-medium transition-all border border-transparent text-[color:var(--color-ink-secondary)] hover:text-[color:var(--color-ink-strong)] hover:bg-[color:var(--color-surface-soft)] cursor-pointer"
                >
                  {cat.label}
                </button>
              </li>
            ))}
          </ul>

          <!-- Mobile Category Filters (Horizontal Scroll) -->
          <div class="flex lg:hidden overflow-x-auto pb-3 gap-2 scrollbar-none snap-x">
            {categories.map((cat) => (
              <button
                data-filter={cat.id}
                class="filter-btn shrink-0 snap-start rounded-full border border-[color:var(--color-border)] px-4 py-1.5 text-xs font-medium transition-all text-[color:var(--color-ink-secondary)] bg-white hover:text-[color:var(--color-ink-strong)] cursor-pointer"
              >
                {cat.label}
              </button>
            ))}
          </div>
        </div>

        <!-- Integrations View -->
        <div>
          <!-- Empty State -->
          <div id="empty-state" class="hidden text-center py-16">
            <svg class="mx-auto h-12 w-12 text-[color:var(--color-ink-muted)] opacity-60" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" />
            </svg>
            <h3 class="mt-4 text-sm font-semibold text-[color:var(--color-ink-strong)]">No integrations found</h3>
            <p class="mt-2 text-xs text-[color:var(--color-ink-secondary)]">Try adjusting your search terms or category filter.</p>
          </div>

          <!-- Cards Grid -->
          <div id="integrations-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
            {items.map((i) => (
              <div
                data-card
                data-name={i.name.toLowerCase()}
                data-desc={i.desc.toLowerCase()}
                data-category={i.catId}
                class="flex flex-col justify-between rounded-2xl border border-[color:var(--color-border)] bg-white p-5 transition-all hover:border-[color:var(--color-brand)]/40 hover:shadow-[0_8px_30px_rgba(0,0,0,0.02)]"
              >
                <div>
                  <div class="flex items-start justify-between">
                    <div class="grid h-12 w-12 place-items-center rounded-xl bg-[color:var(--color-surface-soft)] overflow-hidden p-2">
                      <img
                        src={`/logos/${i.logoKey}.webp`}
                        alt={`${i.name} Logo`}
                        width="48"
                        height="48"
                        class="h-full w-full object-contain rounded-md"
                        loading="lazy"
                      />
                    </div>
                    {i.badge && (
                      <span class="inline-flex items-center rounded-full bg-[color:var(--color-brand-50)] px-2.5 py-0.5 text-[10px] font-semibold text-[color:var(--color-brand-on-light)] border border-[color:var(--color-brand-100)]">
                        {i.badge}
                      </span>
                    )}
                  </div>
                  <h3 class="mt-4 font-display text-base font-semibold text-[color:var(--color-ink-strong)] leading-tight">{i.name}</h3>
                  <span class="text-[10px] uppercase tracking-wider font-semibold text-[color:var(--color-ink-muted)]">{i.category}</span>
                  <p class="mt-2 text-[13px] font-light leading-relaxed text-[color:var(--color-ink-secondary)]">{i.desc}</p>
                </div>
                <div class="mt-5 pt-4 border-t border-[color:var(--color-divider)] flex items-center justify-between text-xs text-[color:var(--color-ink-secondary)]">
                  <span class="flex items-center gap-1.5 font-medium">
                    <span class="h-1.5 w-1.5 rounded-full bg-[color:var(--color-brand)]"></span>
                    Native Sync
                  </span>
                  <button
                    data-docs-trigger
                    data-vendor-name={i.name}
                    data-vendor-logo={i.logoKey}
                    data-vendor-category={i.category}
                    data-vendor-key={i.logoKey}
                    class="hover:text-[color:var(--color-brand)] font-medium inline-flex items-center gap-1 transition-colors cursor-pointer bg-transparent border-0 p-0 text-xs text-[color:var(--color-ink-secondary)]"
                  >
                    Setup docs
                    <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Request Integration CTA Section -->
    <section class="py-16 sm:py-20 text-center bg-[color:var(--color-surface-soft)]">
      <div class="px-5 sm:px-8 max-w-xl mx-auto">
        <span class="eyebrow">Request more</span>
        <h2 class="h-section mt-4">
          Need a custom
          <span class="font-display-italic text-[color:var(--color-foreground-secondary)]"> integration?</span>
        </h2>
        <p class="mt-4 text-sm font-light leading-relaxed text-[color:var(--color-ink-secondary)]">
          Can't find the tool your team uses? We build custom integrations for our Growth and Enterprise clients within 48 hours. Let us know what you need.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row justify-center gap-3">
          <a href="mailto:founders@typpout.com?subject=Integration%20Request" class="btn btn-brand">
            Request Integration
          </a>
          <a href={SITE.demoUrl} class="btn btn-ghost">
            Talk to sales
          </a>
        </div>
      </div>
    </section>

    <!-- Setup Docs Modal -->
    <div
      id="docs-modal"
      class="fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300 bg-black/50 backdrop-blur-xs"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-title"
    >
      <div class="relative w-full max-w-lg transform rounded-2xl bg-white p-6 shadow-xl transition-all duration-300 translate-y-4 border border-[color:var(--color-border)]">
        <!-- Close Button -->
        <button
          id="close-modal-btn"
          class="absolute top-4 right-4 text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-ink-strong)] transition-colors cursor-pointer"
          aria-label="Close modal"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <!-- Modal Header -->
        <div class="flex items-center gap-3.5 border-b border-[color:var(--color-divider)] pb-4">
          <div class="grid h-12 w-12 place-items-center rounded-xl bg-[color:var(--color-surface-soft)] overflow-hidden p-2 border border-[color:var(--color-border)]/50">
            <img
              id="modal-logo"
              src="/logos/clay.webp"
              alt="Vendor Logo"
              width="48"
              height="48"
              class="h-full w-full object-contain rounded-md"
            />
          </div>
          <div>
            <h3 id="modal-title" class="font-display text-lg font-bold text-[color:var(--color-ink-strong)]">Clay Setup</h3>
            <span id="modal-category" class="text-[10px] uppercase tracking-wider font-semibold text-[color:var(--color-brand-on-light)]">Data & Enrichment</span>
          </div>
        </div>

        <!-- Modal Content -->
        <div class="mt-6">
          <h4 class="text-xs font-semibold uppercase tracking-wider text-[color:var(--color-ink-muted)]">Step-by-step instructions</h4>
          <ol id="modal-steps" class="mt-3 space-y-4 text-sm text-[color:var(--color-ink-secondary)] leading-relaxed list-none">
            <!-- Dynamic steps go here -->
          </ol>
        </div>

        <!-- Modal Footer -->
        <div class="mt-8 flex justify-end gap-3 border-t border-[color:var(--color-divider)] pt-4">
          <button id="modal-secondary-btn" class="btn btn-sm btn-ghost cursor-pointer">Close</button>
          <a id="modal-primary-btn" href="https://dashboard.typpout.com" target="_blank" rel="noopener" class="btn btn-sm btn-brand cursor-pointer font-semibold">Go to dashboard</a>
        </div>
      </div>
    </div>
  </div>
  
  <FinalCTA />
</Layout>

<script>
  const searchInput = document.getElementById("search-input") as HTMLInputElement | null;
  const filterBtns = document.querySelectorAll(".filter-btn");
  const cards = document.querySelectorAll("[data-card]");
  const emptyState = document.getElementById("empty-state");

  let currentCategory = "all";
  let currentSearch = "";

  const docData = {
    clay: {
      steps: [
        "Log into your **Typpout dashboard**, head to **Settings > API**, and generate a new API token.",
        "Open your workspace in **Clay** and create or select a table.",
        "Add a new enrichment column and search for **Typpout**.",
        "Paste your Typpout API token to authenticate the block.",
        "Map your B2B prospect profiles to trigger automated intent scoring and research sync."
      ]
    },
    hubspot: {
      steps: [
        "In Typpout, navigate to **Settings > Integrations** and click **Connect HubSpot**.",
        "Log in to your HubSpot account when prompted by the secure OAuth screen.",
        "Select your HubSpot account/portal and grant the required permissions.",
        "Map Typpout lead data fields (e.g., social handle, match score) to your HubSpot Contact properties.",
        "Toggle **Automatic Sync** to push high-intent social prospects directly to your CRM contacts list."
      ]
    },
    n8n: {
      steps: [
        "In your n8n workflow editor, add a new **Webhook node** set to `POST`.",
        "Copy the production Webhook URL generated by n8n.",
        "In Typpout, go to **Settings > Webhooks** and click **Add Webhook**.",
        "Paste the n8n webhook URL and select the event triggers (e.g., *Signal Detected*, *Lead Matched*).",
        "Save settings and run a test payload to confirm the webhook connection in n8n."
      ]
    },
    salesforce: {
      steps: [
        "Go to **Settings > Integrations** in the Typpout dashboard and click **Salesforce**.",
        "Select either your **Sandbox** or **Production** environment.",
        "Authenticate using your Salesforce admin credentials and authorize access.",
        "Map standard fields such as Name, Title, and Company, and set custom attributes like *Social Signal* and *Match Score*.",
        "Save and enable the integration to start pushing intent leads directly into Salesforce."
      ]
    },
    slack: {
      steps: [
        "In your Typpout settings under **Integrations**, select **Slack** and click **Add to Slack**.",
        "Authorize the Typpout Slack Bot to access your Slack workspace.",
        "Select the target Slack channel (e.g., `#sales-alerts` or `#gtm-intent`).",
        "Set matching thresholds (e.g., only alert for scores above 90% or competitor keywords).",
        "Click **Send Test Alert** to verify the channel notifications are active."
      ]
    },
    notion: {
      steps: [
        "In Typpout, navigate to **Integrations > Notion** and click **Connect Notion**.",
        "Select the Notion workspace and pages you want to share with the integration.",
        "Click **Allow Access** to authorize and complete the Notion sync.",
        "Select the specific Notion database where you want social leads to be routed.",
        "Map Typpout properties to your Notion database properties and click **Enable notion sync**."
      ]
    },
    airtable: {
      steps: [
        "Go to your Airtable Developer Hub and create a **Personal Access Token** with `data.records:write` permissions.",
        "Under **Integrations > Airtable** in Typpout, enter your Access Token.",
        "Select the Target Base and Table where you want to add prospect leads.",
        "Map the Airtable table columns to the matching Typpout lead data variables.",
        "Click **Save Configuration** to start sending real-time social leads directly into your database."
      ]
    },
    zapier: {
      steps: [
        "Search for **Typpout** in the Zapier App Directory and select it.",
        "Create a new Zap, choosing **Typpout** as the Trigger app.",
        "Select the trigger event (e.g., *New High-Intent Signal* or *New Booked Meeting*).",
        "Connect your Typpout account by entering the API Key found in your Developer Settings.",
        "Configure your Action steps in Zapier to route the incoming GTM data to 5,000+ apps."
      ]
    },
    apollo: {
      steps: [
        "Log into Apollo.io, go to **Settings > API**, and copy your Apollo API Key.",
        "In Typpout, go to **Integrations > Apollo** and paste your API Key.",
